{
  "version": "3.0",
  "default_mode": "solo",
  "risk_scoring": {
    "weights": {
      "guard_violation": 40,
      "budget_soft_exceeded": 20,
      "budget_hard_exceeded": 50,
      "check_failure": 15,
      "retry_attempt": 10
    },
    "thresholds": {
      "low": 25,
      "medium": 50,
      "high": 100
    }
  },
  "price_table": {
    "default": {
      "input_per_1m": 3.00,
      "output_per_1m": 15.00,
      "cached_per_1m": 0.30
    }
  },
  "sandbox": {
    "type": "process",
    "env_allowlist": [
      "PATH",
      "SYSTEMDRIVE",
      "SYSTEMROOT",
      "HOME",
      "TEMP",
      "TMP",
      "USERPROFILE",
      "FACTORY_*"
    ],
    "strict_cwd": true,
    "network_allowlist": ["github.com", "pypi.org", "registry.npmjs.org"],
    "resource_limits": {
      "cpu_seconds": 3600,
      "memory_mb": 4096,
      "disk_mb": 10240
    }
  },
  "defaults": {
    "max_concurrent_jobs": 1,
    "hard_budget_usd": 25.00,
    "soft_budget_usd": 10.00
  }
}
