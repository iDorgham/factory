#!/usr/bin/env python3
"""Convenience launcher for the factory CLI.

Usage:
  ./factory project create myapp --mode solo
  ./factory job run myapp "Build a landing page"
  ./factory doctor
"""
import sys
from pathlib import Path

# Make the package importable
ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "kernel" / "src"))

from factory_kernel.cli import main

if __name__ == "__main__":
    sys.exit(main())
