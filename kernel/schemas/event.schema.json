{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/event.schema.json",
  "title": "Job Event",
  "type": "object",
  "required": ["id", "ts", "job", "type", "actor", "fence", "data", "prev"],
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "ts": { "type": "string", "format": "date-time" },
    "job": { "type": "string" },
    "type": {
      "type": "string",
      "enum": [
        "job.created",
        "job.state_changed",
        "stage.started",
        "stage.attempt_started",
        "stage.attempt_finished",
        "stage.accepted",
        "stage.rejected",
        "checks.completed",
        "gate.evaluated",
        "human.approval",
        "human.answer",
        "lease.acquired",
        "lease.renewed",
        "lease.released",
        "budget.soft_exceeded",
        "budget.hard_exceeded",
        "checkpoint.created",
        "merge.completed",
        "merge.conflict",
        "merge.undone",
        "effect.journaled",
        "job.completed",
        "job.failed",
        "job.cancelled",
        "job.archived"
      ]
    },
    "actor": { "type": "string" },
    "fence": { "type": "integer", "minimum": 0 },
    "data": { "type": "object" },
    "prev": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
