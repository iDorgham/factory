{
  "mode": "enterprise",
  "stage_profile": "standard",
  "max_concurrent_jobs": 16,
  "gates": {
    "visual_approval": "if_ui_changed",
    "plan_approval": "if_risk_above:low",
    "skill_promotion": "always_human",
    "architecture_change": "always",
    "auto_merge": {
