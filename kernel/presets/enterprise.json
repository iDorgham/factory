  },
  "budgets": {
    "job_hard_usd": 100.00,
    "job_soft_usd": 40.00,
    "attempt_tokens": 1200000,
    "project_month_usd": 2000.00,
    "brand_month_usd": 10000.00
  },
  "dashboard_panels": ["jobs", "queues", "approvals", "cost", "prs", "policy", "audit", "brands"],
  "rbac": true,
  "audit_chain": true,
  "compliance": true,
  "change_windows": true
}
