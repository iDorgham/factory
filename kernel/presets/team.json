{
  "mode": "team",
  "stage_profile": "standard",
  "max_concurrent_jobs": 4,
  "gates": {
    "visual_approval": "if_ui_changed",
    "plan_approval": "if_risk_above:medium",
    "skill_promotion": "always_human",
    "architecture_change": "if_risk_above:low",
    "auto_merge": {
      "enabled": false,
      "requires": ["required_checks_pass", "no_blocking_findings", "risk_at_most:low", "visual_approved_if_ui"]
    }
  },
  "budgets": {
    "job_hard_usd": 50.00,
    "job_soft_usd": 20.00,
    "attempt_tokens": 800000,
    "project_month_usd": 500.00
  },
  "dashboard_panels": ["jobs", "queues", "approvals", "cost", "prs"],
  "rbac": true,
  "audit_chain": true
}
