# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/

# Derived, rebuildable state (see spec §5.1 / §4.2)
state/index.json

# Per-job worktrees (outside version control, see spec §5.1)
.work/

# Factory-managed project repositories (nested git repos under projects/)
projects/*/repo/

# Runtime projects are ephemeral machine state, not source. The `demo`
# project is kept tracked as deliberate bug evidence (see docs/context).
projects/*
!projects/demo/

# Runtime project jobs are ephemeral machine state, not source. The `demo`
# project is kept tracked as deliberate bug evidence (see docs/context).
projects/*/jobs/
!projects/demo/jobs/
